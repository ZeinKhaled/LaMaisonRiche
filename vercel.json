{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "bindings": []
    },
    "la-maison-riche": {
      "root": "artifacts/la-maison-riche",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "api-server",
          "format": "url",
          "env": "VITE_API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api-server" }
    },
    {
      "source": "/uploads/(.*)",
      "destination": { "service": "api-server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "la-maison-riche" }
    }
  ]
}